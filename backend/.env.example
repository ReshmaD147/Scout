# Scout backend — environment variables
# Copy this file to .env and fill in real values. Never commit .env itself.

# ── Model provider selection ─────────────────────────────────────────────
# Which LLM backend the agents use. One of: groq | claude | gemini | ollama
# All four are genuinely wired and tested in this project.
MODEL_PROVIDER=ollama

# ── Ollama (local, free, no API key needed) ──────────────────────────────
# Only used when MODEL_PROVIDER=ollama. Requires `ollama serve` running
# locally and the model already pulled (e.g. `ollama pull qwen3:8b`).
# Note: local Ollama processes one request at a time — running the eval
# suite and manual tests simultaneously against it will cause request
# queuing and apparent timeouts. Run Ollama evals in isolation.
OLLAMA_MODEL=qwen3:8b
OLLAMA_BASE_URL=http://localhost:11434
MODEL_INVOCATION_TIMEOUT_SECONDS=45
SUB_INTENT_TIMEOUT_SECONDS=90
CHAT_REQUEST_TIMEOUT_SECONDS=110

# ── Demo auth (local development only) ───────────────────────────────────
# Enables a local-only "sign in as seeded demo customer" flow for order
# demos. The backend disables this automatically when APP_ENV=production.
APP_ENV=development
ENABLE_DEMO_AUTH=true
DEMO_CUSTOMER_IDS=C001,C002

# ── Groq ──────────────────────────────────────────────────────────────────
# Fast, but has a daily token quota that heavy testing can exhaust.
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.6-27b

# ── Anthropic Claude ──────────────────────────────────────────────────────
# claude-haiku-4-5 costs roughly $2-3/day of heavy manual testing +
# eval runs (confirmed via the Anthropic Console usage dashboard).
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-haiku-4-5-20251001

# ── Google Gemini ─────────────────────────────────────────────────────────
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# ── Stripe (test mode only — never use live keys here) ───────────────────
# Used by the deterministic checkout route only. No agent has access to
# any Stripe-related tool, by design — see CLAUDE.md "Security boundaries".
STRIPE_MCP_KEY=
ENABLE_STRIPE_MCP=false

# ── Embeddings (used for RAG policy Q&A and semantic product search) ────
# Always runs via Ollama's nomic-embed-text model, independent of
# whichever MODEL_PROVIDER is set above for chat/reasoning.
# Requires: ollama pull nomic-embed-text
EMBEDDING_MODEL=nomic-embed-text
